---
const adminUrl = import.meta.env.PUBLIC_ADMIN_URL ?? "https://app.wireframes.dev";
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-inner">
    <h1 id="hero-heading">
      Design wireframe prototypes<br />
      <span class="highlight">from simple YAML specs</span>
    </h1>
    <p class="hero-sub">
      Define your interface in declarative YAML. Preview clickable prototypes
      instantly. Share with your team — no design tools required.
    </p>
    <div class="hero-actions">
      <a href={adminUrl} class="btn btn-primary btn-lg">Get Started</a>
      <a href="#features" class="btn btn-outline btn-lg">See Features</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-4xl) 0;
    text-align: center;
    background: linear-gradient(
      180deg,
      var(--color-primary-light) 0%,
      var(--color-bg) 100%
    );
  }

  .hero-inner {
    max-width: 720px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.02em;
  }

  .highlight {
    color: var(--color-primary);
  }

  .hero-sub {
    margin-top: var(--space-lg);
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    margin-top: var(--space-2xl);
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-lg {
    padding: 0.875rem 2rem;
    font-size: 1.0625rem;
  }
</style>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wireframe.spec/schema/v1.1.json",
  "title": "Wireframe Specification v1.1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/ManifestDocument" },
    { "$ref": "#/$defs/SitemapDocument" },
    { "$ref": "#/$defs/TemplatesDocument" },
    { "$ref": "#/$defs/ComponentsDocument" },
    { "$ref": "#/$defs/PageDocument" },
    { "$ref": "#/$defs/DatasetDocument" }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "StateKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "Expression": {
      "type": "string",
      "pattern": "^\\{\\{(state|appState|route|event|props|item)\\.[a-z][a-z0-9_\\.]*\\}\\}$"
    },
    "Condition": {
      "oneOf": [
        { "$ref": "#/$defs/CondStateEquals" },
        { "$ref": "#/$defs/CondRouteMatch" },
        { "$ref": "#/$defs/CondCompare" },
        { "$ref": "#/$defs/CondAnd" },
        { "$ref": "#/$defs/CondOr" },
        { "$ref": "#/$defs/CondNot" }
      ]
    },
    "CondStateEquals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope", "key", "equals"],
      "properties": {
        "type": { "const": "state_equals" },
        "scope": { "type": "string", "enum": ["page", "app"] },
        "key": { "$ref": "#/$defs/StateKey" },
        "equals": {}
      }
    },
    "CondRouteMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "routeId"],
      "properties": {
        "type": { "const": "route_match" },
        "routeId": { "$ref": "#/$defs/Id" }
      }
    },
    "CondCompare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "left", "op", "right"],
      "properties": {
        "type": { "const": "compare" },
        "left": {
          "oneOf": [
            { "$ref": "#/$defs/Expression" },
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "op": { "type": "string", "enum": ["eq", "ne", "gt", "gte", "lt", "lte"] },
        "right": {
          "oneOf": [
            { "$ref": "#/$defs/Expression" },
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "CondAnd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": { "const": "and" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Condition" }
        }
      }
    },
    "CondOr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": { "const": "or" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Condition" }
        }
      }
    },
    "CondNot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "condition"],
      "properties": {
        "type": { "const": "not" },
        "condition": { "$ref": "#/$defs/Condition" }
      }
    },
    "Size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string" }] },
        "height": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string" }] },
        "minWidth": { "type": "number", "minimum": 0 },
        "maxWidth": { "type": "number", "minimum": 0 },
        "minHeight": { "type": "number", "minimum": 0 },
        "maxHeight": { "type": "number", "minimum": 0 }
      }
    },
    "GridItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "span": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "Visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition"],
      "properties": {
        "condition": { "$ref": "#/$defs/Condition" }
      }
    },
    "Accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "role": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/Expression" },
        "itemVar": { "type": "string" }
      }
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "stateKey"],
      "properties": {
        "selectable": { "type": "boolean" },
        "scope": { "type": "string", "enum": ["page", "app"] },
        "stateKey": { "$ref": "#/$defs/StateKey" }
      }
    },
    "Interaction": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "navigation", "open_overlay", "close_overlay", "toggle",
            "set_state", "submit", "action", "gesture"
          ]
        },
        "targetRoute": { "$ref": "#/$defs/Id" },
        "targetOverlay": { "$ref": "#/$defs/Id" },
        "scope": { "type": "string", "enum": ["page", "app"] },
        "stateKey": { "$ref": "#/$defs/StateKey" },
        "value": {},
        "formId": { "$ref": "#/$defs/Id" },
        "actionId": { "$ref": "#/$defs/Id" },
        "gestureType": {
          "type": "string",
          "enum": [
            "swipe_left", "swipe_right", "swipe_up", "swipe_down",
            "long_press", "pinch", "double_tap"
          ]
        },
        "condition": { "$ref": "#/$defs/Condition" }
      }
    },
    "Overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": {
          "type": "string",
          "enum": [
            "dropdown", "popover", "modal", "drawer_left", "drawer_right",
            "bottom_sheet", "toast", "alert", "tooltip"
          ]
        },
        "trigger": { "$ref": "#/$defs/Id" },
        "placement": { "type": "string", "enum": ["top", "bottom", "left", "right", "center"] },
        "dismissOn": {
          "type": "array",
          "items": { "type": "string", "enum": ["backdrop", "escape", "button", "timeout"] }
        },
        "content": { "type": "array", "items": { "$ref": "#/$defs/Node" } },
        "wireframeStyle": { "$ref": "#/$defs/WireframeStyleOverride" }
      }
    },
    "Pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resizable", "collapsible"],
      "properties": {
        "side": { "type": "string", "enum": ["left", "right", "center"] },
        "defaultSize": { "type": "integer", "minimum": 0 },
        "minSize": { "type": "integer", "minimum": 0 },
        "maxSize": { "type": "integer", "minimum": 0 },
        "collapsedSize": { "type": "integer", "minimum": 0 },
        "resizable": { "type": "boolean" },
        "collapsible": { "type": "boolean" },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "sizeKey", "collapsedKey"],
          "properties": {
            "scope": { "type": "string", "enum": ["app", "page"] },
            "sizeKey": { "$ref": "#/$defs/StateKey" },
            "collapsedKey": { "$ref": "#/$defs/StateKey" }
          }
        }
      }
    },
    "WireframeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["border"],
      "properties": {
        "border": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style"],
          "properties": {
            "style": { "type": "string", "enum": ["solid", "dashed"] },
            "width": { "type": "string", "enum": ["thin", "medium"] }
          }
        },
        "corner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "enum": ["sharp", "rounded"] },
            "radius": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "WireframeStyleOverride": {
      "type": "object",
      "additionalProperties": false,
      "description": "Partial wireframe style for per-node and per-overlay overrides. No fields required — inherits from page.",
      "properties": {
        "border": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "enum": ["solid", "dashed"] },
            "width": { "type": "string", "enum": ["thin", "medium"] }
          }
        },
        "corner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "enum": ["sharp", "rounded"] },
            "radius": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "Viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device"],
      "properties": {
        "device": { "type": "string", "enum": ["mobile", "tablet", "web"] },
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] }
      },
      "if": {
        "properties": { "device": { "enum": ["mobile", "tablet"] } }
      },
      "then": {
        "required": ["device", "orientation"]
      }
    },
    "PrimitiveComponent": {
      "type": "string",
      "enum": [
        "heading", "paragraph", "text",
        "image",
        "button", "input", "textarea", "select", "checkbox", "toggle",
        "section", "divider", "spacer"
      ]
    },
    "Layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["stack", "row", "grid", "absolute", "overlay"] },
        "gap": { "type": "number", "minimum": 0 },
        "padding": { "type": "number", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 1 },
        "justify": { "type": "string" },
        "align": { "type": "string" }
      }
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "component": { "type": "string" },
        "use": { "$ref": "#/$defs/Id" },
        "injectable": { "type": "boolean", "const": true },
        "props": { "type": "object" },
        "role": { "type": "string" },
        "layout": { "$ref": "#/$defs/Layout" },
        "size": { "$ref": "#/$defs/Size" },
        "gridItem": { "$ref": "#/$defs/GridItem" },
        "visibility": { "$ref": "#/$defs/Visibility" },
        "accessibility": { "$ref": "#/$defs/Accessibility" },
        "binding": { "$ref": "#/$defs/Binding" },
        "interaction": { "type": "array", "items": { "$ref": "#/$defs/Interaction" } },
        "selection": { "$ref": "#/$defs/Selection" },
        "stateBindings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Expression" } },
        "pane": { "$ref": "#/$defs/Pane" },
        "wireframeStyle": { "$ref": "#/$defs/WireframeStyleOverride" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Node" }
        }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["component"] },
            { "required": ["use"] },
            { "required": ["injectable"] }
          ]
        }
      ]
    },
    "ManifestDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "specVersion", "id", "manifest"],
      "properties": {
        "documentType": { "const": "manifest" },
        "specVersion": { "const": "1.1" },
        "id": { "$ref": "#/$defs/Id" },
        "manifest": {
          "type": "object",
          "required": ["projectId", "name", "schemaVersion"],
          "properties": {
            "projectId": { "$ref": "#/$defs/Id" },
            "name": { "type": "string" },
            "schemaVersion": { "type": "string" },
            "createdWithCLI": { "type": "string" },
            "defaultGridColumns": { "type": "integer", "minimum": 1 },
            "defaultWireframeStyle": { "$ref": "#/$defs/WireframeStyle" }
          }
        }
      }
    },
    "SitemapDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "specVersion", "id", "routes"],
      "properties": {
        "documentType": { "const": "sitemap" },
        "specVersion": { "const": "1.1" },
        "id": { "$ref": "#/$defs/Id" },
        "defaultTemplate": { "$ref": "#/$defs/Id" },
        "appState": { "type": "object" },
        "contexts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "minWidth": { "type": "integer", "minimum": 0 },
              "maxWidth": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "page", "template"],
            "properties": {
              "id": { "$ref": "#/$defs/Id" },
              "path": { "type": "string" },
              "page": { "$ref": "#/$defs/Id" },
              "template": { "$ref": "#/$defs/Id" }
            }
          }
        }
      }
    },
    "TemplatesDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "specVersion", "id", "templates"],
      "properties": {
        "documentType": { "const": "templates" },
        "specVersion": { "const": "1.1" },
        "id": { "$ref": "#/$defs/Id" },
        "templates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["layout", "regions"],
            "properties": {
              "layout": { "$ref": "#/$defs/Layout" },
              "regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "kind"],
                  "properties": {
                    "id": { "$ref": "#/$defs/Id" },
                    "kind": { "type": "string", "enum": ["persistent", "slot"] },
                    "component": { "type": "string" },
                    "use": { "$ref": "#/$defs/Id" },
                    "layout": { "$ref": "#/$defs/Layout" },
                    "pane": { "$ref": "#/$defs/Pane" },
                    "children": { "type": "array", "items": { "$ref": "#/$defs/Node" } }
                  }
                }
              },
              "overlays": {
                "type": "array",
                "items": { "$ref": "#/$defs/Overlay" }
              }
            }
          }
        }
      }
    },
    "ComponentsDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "specVersion", "id", "components"],
      "properties": {
        "documentType": { "const": "components" },
        "specVersion": { "const": "1.1" },
        "id": { "$ref": "#/$defs/Id" },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["root"],
            "properties": {
              "root": { "$ref": "#/$defs/Node" },
              "propDefaults": { "type": "object" },
              "propHints": { "type": "object" }
            }
          }
        }
      }
    },
    "PageDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "specVersion", "id", "page"],
      "properties": {
        "documentType": { "const": "page" },
        "specVersion": { "const": "1.1" },
        "id": { "$ref": "#/$defs/Id" },
        "page": {
          "type": "object",
          "required": ["id", "template", "viewport", "wireframeStyle", "slots"],
          "properties": {
            "id": { "$ref": "#/$defs/Id" },
            "template": { "$ref": "#/$defs/Id" },
            "viewport": { "$ref": "#/$defs/Viewport" },
            "wireframeStyle": { "$ref": "#/$defs/WireframeStyle" },
            "pageState": { "type": "object" },
            "dataSources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "dataset"],
                "properties": {
                  "id": { "$ref": "#/$defs/Id" },
                  "dataset": { "$ref": "#/$defs/Id" }
                }
              }
            },
            "actions": { "type": "object" },
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slotId", "content"],
                "properties": {
                  "slotId": { "$ref": "#/$defs/Id" },
                  "content": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Node" }
                  }
                }
              }
            },
            "injectables": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["injectableId", "content"],
                "properties": {
                  "injectableId": { "$ref": "#/$defs/Id" },
                  "content": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Node" }
                  }
                }
              }
            },
            "overlays": {
              "type": "array",
              "items": { "$ref": "#/$defs/Overlay" }
            }
          }
        }
      }
    },
    "DatasetDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "specVersion", "id", "dataset"],
      "properties": {
        "documentType": { "const": "dataset" },
        "specVersion": { "const": "1.1" },
        "id": { "$ref": "#/$defs/Id" },
        "dataset": {
          "type": "object",
          "required": ["id", "primaryKey", "items"],
          "properties": {
            "id": { "$ref": "#/$defs/Id" },
            "primaryKey": { "type": "string" },
            "fields": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Expected field names for items (informational, used for validation hints)"
            },
            "items": {
              "type": "array",
              "items": { "type": "object" },
              "description": "Array of plain key-value objects, each containing the primaryKey field"
            }
          }
        }
      }
    }
  }
}
